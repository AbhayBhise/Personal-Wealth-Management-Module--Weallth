# ─── Node.js & npm ────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# NOTE: package-lock.json is intentionally NOT ignored.
# Lock files must be version-controlled for reproducible CI/CD builds.

# ─── TypeScript Build Outputs ─────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ─── Environment & Secrets ────────────────────────────────────────────
.env
.env.*
*.env

# ─── Logs ─────────────────────────────────────────────────────────────
logs/
*.log

# ─── macOS System Files ───────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ─── IDE & Editor Configuration ───────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.suo

# ─── Python Artifacts (for scripts/build_rag_knowledge.py) ────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/

# ─── Private Research & Copyrighted Source Documents ──────────────────
# The Weallth/ folder contains:
#   - Ric Edelman's book (HarperCollins copyright) — NEVER commit
#   - Internal staff research DOCX/XLSX — keep local
#   - AI Product Studio research outputs — keep local
# To rebuild the RAG knowledge base from these documents,
# see: scripts/build_rag_knowledge.py and research/README.md
Weallth/
research/source_documents/
data/source_documents/

# ─── RAG Knowledge Base (derived from copyrighted sources) ────────────
# rag_knowledge.json is derived from Ric Edelman's copyrighted book.
# 41.1% of its 689 chunks are verbatim HarperCollins-copyrighted text.
# It must NOT be committed to any public repository.
# A sample_rag_knowledge.json (copyright-free placeholder) is committed instead.
# Rebuild instructions: research/README.md
app/backend/src/services/rag/rag_knowledge.json

# ─── Obsolete Runtime Data Files ──────────────────────────────────────
# data.json was the pre-Prisma file-backed database. Now fully obsolete.
# The active app uses PostgreSQL (Docker) via Prisma exclusively.
data.json

# ─── Copyrighted / Licensed Document Types ────────────────────────────
# These file extensions typically contain copyrighted or proprietary content.
# NOTE: Images (.png, .jpg, .svg) are NOT globally ignored — the app
# uses them for UI assets. Only private directories above are excluded.
*.epub
*.pdf
*.docx
*.doc

# ─── Large Binary & Archive Files ─────────────────────────────────────
*.zip
*.rar
*.7z
*.tar.gz

# ─── Video & Presentation Files ───────────────────────────────────────
*.mp4
*.mov
*.avi
*.pptx
*.ppt

# ─── Spreadsheet Files ────────────────────────────────────────────────
*.xlsx
*.xls

# ─── Temporary Dumps & Local Test Scripts ─────────────────────────────
app/backend/src/services/rag/pgvector_embeddings_dump.json
test-gemini.js
app/backend/test-gemini.js
