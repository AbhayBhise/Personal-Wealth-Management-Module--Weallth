## 5. DEPLOYMENT AUTOMATION

### 5.1 CI/CD Pipeline

**GitHub Actions Workflow:**
```yaml
name: Production Deployment

on:
  workflow_dispatch:  # Manual trigger only
    inputs:
      environment:
        required: true
        default: 'production'

jobs:
  pre-deployment-checks:
    runs-on: ubuntu-latest
    steps:
      - name: Verify pre-deployment checklist
        run: |
          ./scripts/pre-deployment-check.sh
      
      - name: Run smoke tests
        run: |
          npm test -- --suite=smoke
      
      - name: Validate configuration
        run: |
          ./scripts/validate-config.sh

  deploy-to-green:
    needs: pre-deployment-checks
    runs-on: ubuntu-latest
    steps:
      - name: Build Docker images
        run: |
          docker build -t platform:${{ github.sha }} .
          docker push ecr.amazonaws.com/platform:${{ github.sha }}
      
      - name: Deploy to Green environment
        run: |
          kubectl apply -f k8s/green/ -n production
          kubectl rollout status deployment -n production
      
      - name: Run smoke tests on Green
        run: |
          ./scripts/smoke-test-green.sh
      
      - name: Switch traffic to Green
        run: |
          kubectl patch service api-gateway -p \
            '{"spec":{"selector":{"environment":"green"}}}'
      
      - name: Monitor for 30 minutes
        run: |
          ./scripts/monitor-deployment.sh

  rollback:
    if: failure()
    needs: deploy-to-green
    runs-on: ubuntu-latest
    steps:
      - name: Switch traffic back to Blue
        run: |
          kubectl patch service api-gateway -p \
            '{"spec":{"selector":{"environment":"blue"}}}'
      
      - name: Notify team
        run: |
          curl -X POST ${{ secrets.SLACK_WEBHOOK }} \
            -d '{"text":"Deployment rolled back - investigating"}'
```

