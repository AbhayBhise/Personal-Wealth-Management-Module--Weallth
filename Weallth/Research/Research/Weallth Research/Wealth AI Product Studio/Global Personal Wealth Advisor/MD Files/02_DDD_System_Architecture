CREATE INDEX idx_positions_account ON positions(account_id);
CREATE INDEX idx_positions_asofdate ON positions(as_of_date);

-- Securities (Master List)
CREATE TABLE securities (
    security_id UUID PRIMARY KEY,
    ticker VARCHAR(20),
    isin VARCHAR(20),
    cusip VARCHAR(20),
    name VARCHAR(255),
    asset_class VARCHAR(50), -- Equity, Fixed Income, ETF, Mutual Fund, Alternative
    sector VARCHAR(100),
    country VARCHAR(100),
    market_data_id VARCHAR(50),
    created_at TIMESTAMP,
    updated_at TIMESTAMP
);

CREATE UNIQUE INDEX idx_securities_ticker ON securities(ticker);

-- Portfolio Models
CREATE TABLE models (
    model_id UUID PRIMARY KEY,
    firm_id UUID,
    name VARCHAR(255),
    description TEXT,
    strategy VARCHAR(100),
    target_allocation JSONB, -- {equity: 60, fixed_income: 30, cash: 10}
    drift_threshold DECIMAL(5,2),
    rebalance_frequency VARCHAR(50), -- Monthly, Quarterly, Annual
    created_at TIMESTAMP,
    updated_at TIMESTAMP
);

-- Model allocations
CREATE TABLE model_allocations (
    allocation_id UUID PRIMARY KEY,
    model_id UUID REFERENCES models,
    security_id UUID REFERENCES securities,
    target_weight DECIMAL(5,2),
    min_weight DECIMAL(5,2),
    max_weight DECIMAL(5,2),
    created_at TIMESTAMP
);

-- Financial Plans
CREATE TABLE financial_plans (
    plan_id UUID PRIMARY KEY,
    household_id UUID REFERENCES households,
    advisor_id UUID,
    plan_date DATE,
    retirement_age INT,
    life_expectancy_age INT,
    assumed_return DECIMAL(5,2),
    assumed_inflation DECIMAL(5,2),
    plan_data JSONB,
    status VARCHAR(50), -- Draft, Active, Archived
    created_at TIMESTAMP,
    updated_at TIMESTAMP
);

-- Goals
CREATE TABLE goals (
    goal_id UUID PRIMARY KEY,
    plan_id UUID REFERENCES financial_plans,
    goal_name VARCHAR(255),
    goal_type VARCHAR(50), -- Retirement, Education, Home, etc.
    target_date DATE,
    target_amount DECIMAL(18,2),
    current_amount DECIMAL(18,2),
    status VARCHAR(50), -- On Track, At Risk, Achieved
    priority INT,
    created_at TIMESTAMP,
    updated_at TIMESTAMP
);

-- Trades
CREATE TABLE trades (
    trade_id UUID PRIMARY KEY,
    account_id UUID REFERENCES accounts,
    security_id UUID,
    trade_type VARCHAR(10), -- BUY, SELL
    quantity DECIMAL(18,4),
    price DECIMAL(18,4),
    trade_amount DECIMAL(18,2),
    trade_date DATE,
    settlement_date DATE,
    status VARCHAR(50), -- Pending, Settled, Cancelled
    order_id VARCHAR(50),
    created_at TIMESTAMP,
    updated_at TIMESTAMP
);

-- Task Management
CREATE TABLE tasks (
    task_id UUID PRIMARY KEY,
    household_id UUID REFERENCES households,
    assigned_to_user_id UUID REFERENCES users,
    task_type VARCHAR(100),
    description TEXT,
    due_date DATE,
    status VARCHAR(50), -- Open, In Progress, Completed
    priority VARCHAR(50), -- Low, Medium, High
    created_at TIMESTAMP,
    updated_at TIMESTAMP
);

-- Audit Log
CREATE TABLE audit_log (
    log_id BIGSERIAL PRIMARY KEY,
    user_id UUID REFERENCES users,
    action_type VARCHAR(100),
    entity_type VARCHAR(100),
    entity_id UUID,
    old_values JSONB,
    new_values JSONB,
    ip_address INET,
    user_agent TEXT,
    timestamp TIMESTAMP,
    INDEX idx_audit_log_user (user_id),
    INDEX idx_audit_log_entity (entity_id),
    INDEX idx_audit_log_timestamp (timestamp)
