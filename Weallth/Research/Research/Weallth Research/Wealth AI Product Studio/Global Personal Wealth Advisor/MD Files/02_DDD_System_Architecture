## 2. DATA MODEL & DATABASE DESIGN

### 2.1 Core Data Entities

```sql
-- Users & Authentication
CREATE TABLE users (
    user_id UUID PRIMARY KEY,
    email VARCHAR(255) UNIQUE NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    full_name VARCHAR(255),
    firm_id UUID,
    roles JSONB,
    mfa_enabled BOOLEAN DEFAULT FALSE,
    created_at TIMESTAMP,
    updated_at TIMESTAMP,
    deleted_at TIMESTAMP
);

CREATE TABLE sessions (
    session_id UUID PRIMARY KEY,
    user_id UUID REFERENCES users,
    token_hash VARCHAR(255),
    expires_at TIMESTAMP,
    ip_address INET,
    user_agent TEXT,
    created_at TIMESTAMP
);

-- Clients & Households
CREATE TABLE households (
    household_id UUID PRIMARY KEY,
    firm_id UUID,
    name VARCHAR(255),
    primary_client_id UUID,
    creation_date DATE,
    status VARCHAR(50), -- Active, Inactive, Archived
    created_at TIMESTAMP,
    updated_at TIMESTAMP
);

CREATE TABLE clients (
    client_id UUID PRIMARY KEY,
    household_id UUID REFERENCES households,
    first_name VARCHAR(255),
    last_name VARCHAR(255),
    email VARCHAR(255),
    phone VARCHAR(20),
    date_of_birth DATE,
    ssn_hash VARCHAR(255),
    relationship_to_primary VARCHAR(50),
    net_worth DECIMAL(18,2),
    annual_income DECIMAL(18,2),
    risk_tolerance VARCHAR(50), -- Conservative, Moderate, Aggressive
    investment_experience VARCHAR(50),
    accredited_investor BOOLEAN,
    created_at TIMESTAMP,
    updated_at TIMESTAMP
);

-- Accounts
CREATE TABLE accounts (
    account_id UUID PRIMARY KEY,
    household_id UUID REFERENCES households,
    custodian_id VARCHAR(50),
    account_number VARCHAR(255),
    account_type VARCHAR(50), -- Individual, Joint, IRA, 401k, etc.
    status VARCHAR(50),
    open_date DATE,
    cash_balance DECIMAL(18,2),
    settled_cash DECIMAL(18,2),
    unsettled_cash DECIMAL(18,2),
    created_at TIMESTAMP,
    updated_at TIMESTAMP
);

-- Positions (Holdings)
CREATE TABLE positions (
    position_id UUID PRIMARY KEY,
    account_id UUID REFERENCES accounts,
    security_id UUID,
    quantity DECIMAL(18,4),
    unit_price DECIMAL(18,4),
    market_value DECIMAL(18,2),
    cost_basis DECIMAL(18,2),
    unrealized_gain_loss DECIMAL(18,2),
    percent_of_account DECIMAL(5,2),
    as_of_date DATE,
    created_at TIMESTAMP,
    updated_at TIMESTAMP
